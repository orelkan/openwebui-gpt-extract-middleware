# Copy to .env and fill in real values. Never commit .env.

# OpenAI API key used by the middleware for upstream calls (required).
OPENAI_API_KEY=sk-replace-me

# Upstream OpenAI-compatible API base URL (optional, this is the default).
OPENAI_BASE_URL=https://api.openai.com/v1

# File holding the system prompt injected into every chat completion request
# (optional, defaults to middleware/prompts/system_prompt.md).
# SYSTEM_PROMPT_PATH=/path/to/system_prompt.md

# Upstream timeouts in seconds (optional, these are the defaults).
# The read timeout is the longest allowed wait between two chunks of a response.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=120
