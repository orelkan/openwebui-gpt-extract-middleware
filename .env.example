# Copy to .env and fill in real values. Never commit .env.
# One file configures the whole stack: `make up` (docker compose) and the
# local commands `make run` and `make samples` all read it.

# ----- Middleware -----

# OpenAI API key used by the middleware for upstream calls (required).
OPENAI_API_KEY=sk-replace-me

# Upstream OpenAI-compatible API base URL (optional, this is the default).
OPENAI_BASE_URL=https://api.openai.com/v1

# File holding the system prompt injected into every chat completion request
# (optional, defaults to middleware/prompts/system_prompt.md).
# SYSTEM_PROMPT_PATH=/path/to/system_prompt.md

# Upstream timeouts in seconds (optional, these are the defaults).
# The read timeout is the longest allowed wait between two chunks of a response.
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=120

# Extra attempts when a connection to upstream cannot be opened (optional,
# this is the default). Requests that already reached upstream are never retried.
UPSTREAM_CONNECT_RETRIES=2

# How long GET /ready waits for upstream before answering "not ready", in
# seconds (optional, this is the default).
READINESS_TIMEOUT_SECONDS=5

# Log level: DEBUG, INFO, WARNING or ERROR (optional, this is the default).
LOG_LEVEL=INFO

# ----- Stack (docker compose only) -----

# Model preselected in Open WebUI (optional, this is the default).
DEFAULT_MODEL=gpt-6-luna

# Host ports, both bound to localhost only (optional, these are the defaults).
WEBUI_PORT=3000
MIDDLEWARE_PORT=8000

# PostgreSQL database used by Open WebUI (optional, these are the defaults).
# The database is not reachable from outside the compose network.
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=openwebui
POSTGRES_DB=openwebui

# Secret Open WebUI signs its session tokens with (optional for local use).
WEBUI_SECRET_KEY=local-dev-secret
